{
    "name": "schemastud/laravel-blockdoc",
    "description": "A faithful ProseMirror document model for Laravel (Node/Document/Schema) plus a Spatie Data Block base class. Define your node types as Block subclasses; round-trip ProseMirror JSON.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-data": "^4.9",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "schemastud/laravel-data-schemas": "dev-main",
        "laravel/pint": "^1.0"
    },
    "suggest": {
        "schemastud/laravel-data-schemas": "Emit JSON Schema for Block subclasses (BlockJsonSchemaGenerator) for LLM structured output."
    },
    "repositories": [
        {
            "type": "path",
            "url": "../laravel-data-schemas",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "../../rushing/laravel-popcorn",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "Schemastud\\Blockdoc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schemastud\\Blockdoc\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Schemastud\\Blockdoc\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    }
}
